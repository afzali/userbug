/node_modules/
/ui/node_modules/
/runs/
/test-results/
/ui/.svelte-kit/
/ui/build/
.env
.devin/
userbug.config.js
# تنظیماتِ هوش مصنوعی که رابط می‌نویسد: انتخابِ مدل تصمیمِ همین ماشین است،
# و همسایگیِ کلید هم جای گیت نیست.
userbug.settings.json
scenarios/*/_drafts/

# رانندهٔ کاوشِ هدف‌دار: با هر هدفی که کاربر بنویسد یکی ساخته می‌شود و از
# نقشهٔ همان لحظه می‌آید — نقشه‌ای که خودش در گیت نیست. آنچه ارزشِ ماندن
# دارد، پیش‌نویسی است که این اجرا می‌نویسد، و آن هم بعد از بازبینی.
scenarios/*/_quests/

# تعریفِ زمان‌بندی (json) قابل حمل است و می‌ماند؛ راه‌انداز مسیرِ همین ماشین را
# دارد و لاگ هم تاریخِ محلی است.
schedules/*.cmd
schedules/*.log
knowledge/*/credentials.json
knowledge/*/tours/
knowledge/*/fixtures/

# نقشهٔ اپ فعلاً در گیت نمی‌ماند، برخلافِ `_learned` که سرمایه است.
#
# دو دلیل، و هر دو ممکن است روزی برطرف شوند: با هر خزش تغییر می‌کند (پس
# دیفش بی‌معناست)، و نامِ بعضی نماها از دادهٔ همان اجرا می‌آید — در نخستین
# خزشِ واقعی یک گره «منوی ub-657c0be8@userbug.test» نام گرفت، یعنی ایمیلِ
# هویتِ موقتِ همان اجرا. نگه داشتنش در گیت یعنی کامیت کردنِ دادهٔ یک اجرا.
#
# اگر روزی نام‌ها پایدار شدند، جایش در گیت است: خزش گران‌ترین قدمِ این ابزار
# است و هم‌تیمی نباید دوباره بپردازدش.
knowledge/*/map.json

# فهرستِ endpointها کش است، نه دانش: از سورس دوباره ساخته می‌شود و با هر
# اسکن عوض. آنچه ارزشِ ماندن دارد، ناورداهاست که حالتِ آدم (`off` و «چرا»)
# را با خودش دارد.
knowledge/*/endpoints.json

# پروفایلِ مرورگرِ خزش: نشستِ لاگین‌شده و کشِ همین ماشین است، نه دانشِ پروژه.
knowledge/*/profile/

# پروژه‌های محلی — دادهٔ اپِ کاربر است، نه کدِ این ابزار.
#
# یک بار با `git add -A` اشتباهی کامیت شدند. پرونده و نقشه و کانفیگِ یک
# پروژه، دادهٔ همان ماشین است؛ جایش بستهٔ `userbug bundle export` است، نه
# تاریخچهٔ این مخزن.
targets/*.config.js
knowledge/*/
scenarios/*/_learned/

# و سناریوهای همان پروژه‌ها.
#
# `knowledge/*/` از قبل بود ولی این یکی جا مانده بود: سناریوی یک پروژهٔ
# محلی هم دادهٔ همان ماشین است — ایمیل و مسیر و نامِ دکمه‌های اپِ کاربر در
# آن نوشته شده. تنها استثنا خودآزماهای همین ابزار است.
scenarios/*/
!scenarios/_selftest/
